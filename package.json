{
  "name": "padhaku-log",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler d1 migrations apply padhakulog --remote && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply padhakulog --local",
    "db:migrate:remote": "wrangler d1 migrations apply padhakulog --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "prisma generate",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "wrangler d1 migrations apply padhakulog --remote && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^16.4.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20"
  }
}
