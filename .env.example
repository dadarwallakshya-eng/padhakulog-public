# Local `npm run dev` reads this file. For the Cloudflare runtime use .dev.vars
# (local) and `wrangler secret put NAME` (production). Never commit real values.
ADMIN_PASSWORD="change-me"
SESSION_SECRET="long-random-string"
OTP_PEPPER="long-random-string"

# Email for sign-in codes: set ONE option (Cloudflare Workers can't use SMTP).
# Option A: Gmail API (project Gmail or Google Workspace account)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER=""
# Option B: Resend (needs your own domain)
RESEND_API_KEY=""
EMAIL_FROM=""

# Video relay (Cloudflare Realtime TURN): required before real users
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""

# Local Cloudflare preview only: show sign-in codes on the page. NEVER in production.
# UNSAFE_SHOW_OTP_ON_PAGE="1"
